{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(supabase:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(turbo:*)",
      "Read(*)",
      "Edit",
      "Write",
      "mcp__supabase__list_*",
      "mcp__supabase__get_*",
      "mcp__supabase__search_*",
      "mcp__supabase__generate_typescript_types"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cwd=$(jq -r '.cwd // empty'); repo=$(basename \"${cwd:-$PWD}\"); curl -s -m 5 -H \"Title: Claude Code\" -H \"Priority: default\" -H \"Tags: white_check_mark\" -d \"Claude Code finished in $repo\" https://ntfy.sh/josh-claude-alerts-x7y9z >/dev/null 2>&1 || true",
            "timeout": 10,
            "statusMessage": "Pushing finish notification..."
          }
        ]
      }
    ]
  }
}
