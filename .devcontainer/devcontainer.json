{
  "name": "FrameFocus Dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000, 8081],
  // ⚠️ PORT 3000 IS FORWARDED **PUBLIC**, AND OAUTH CANNOT WORK OTHERWISE.
  //
  // Codespaces forwards ports PRIVATE by default. A private port answers any
  // request that does not carry a GitHub tunnel cookie with a 302 to
  // `https://github.dev/pf-signin?...` -- the request never reaches the dev
  // server at all, and nothing is logged, because nothing arrived.
  //
  // That breaks the two 7G routes an outside party calls directly:
  //
  //   /api/quickbooks/callback  Intuit redirects the BROWSER here after
  //                             consent. It is a CROSS-SITE navigation from
  //                             appcenter.intuit.com, so the tunnel cookie is
  //                             not presented and the sign-in interstitial
  //                             swallows the `code`. The connection silently
  //                             never completes.
  //   /api/quickbooks/webhook   Intuit POSTs here with NO session, ever. It
  //                             would see 302s instead of 200s and, after
  //                             retries at 20/30/50 minutes, DISABLE THE
  //                             ENDPOINT.
  //
  // ⚠️ THIS IS A DEVELOPMENT CONCERN ONLY. Production is Vercel on its own
  // domain with no tunnel in front of it, and is unaffected.
  //
  // ⚠️ WHAT IT COSTS, STATED PLAINLY: a public forwarded port is reachable by
  // anyone who has the URL, and this dev server talks to rebuild-test. That is
  // a deliberate trade for being able to develop an integration whose whole
  // point is that Intuit calls us. To opt out, set this back to "private" and
  // accept that OAuth and webhooks cannot be exercised in a Codespace.
  //
  // ⚠️ THIS APPLIES AT CREATION/REBUILD. An ALREADY-RUNNING Codespace keeps
  // whatever visibility it has -- change it in the VS Code PORTS panel
  // (right-click 3000 -> Port Visibility -> Public), or with
  // `gh codespace ports visibility 3000:public`.
  "portsAttributes": {
    "3000": { "label": "Next.js Web", "onAutoForward": "notify", "visibility": "public" },
    "8081": { "label": "Expo Mobile", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "typescript.tsdk": "node_modules/typescript/lib",
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
        ]
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "formulahendry.auto-rename-tag",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
